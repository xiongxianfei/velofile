  <Color x:Key="VfColorTextSecondary">#D3D8E0</Color>
  <SolidColorBrush x:Key="VfBrushTextSecondary" Color="{StaticResource VfColorTextSecondary}" />
  <Color x:Key="VfColorTextMuted">#9AA3AE</Color>
  <SolidColorBrush x:Key="VfBrushTextMuted" Color="{StaticResource VfColorTextMuted}" />
  <Color x:Key="VfColorTextFaint">#747E8C</Color>
  <SolidColorBrush x:Key="VfBrushTextFaint" Color="{StaticResource VfColorTextFaint}" />
