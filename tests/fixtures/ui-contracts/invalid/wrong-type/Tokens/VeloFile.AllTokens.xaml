  <x:Double x:Key="VfDensityRowHeight">30</x:Double>
  <x:Double x:Key="VfFileListRowHeight">30</x:Double>
  <x:Double x:Key="VfDensityRowPaddingX">12</x:Double>
  <x:Double x:Key="VfDensityRowPaddingY">6</x:Double>

