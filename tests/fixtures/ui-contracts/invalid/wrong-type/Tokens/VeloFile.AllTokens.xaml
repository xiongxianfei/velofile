  <x:Double x:Key="VfFocusInset">1</x:Double>
  <SolidColorBrush x:Key="VfFocusBrush" Color="{StaticResource VfColorAccentLine}" />
  <x:Double x:Key="VfStateHiddenOpacity">0.68</x:Double>
  <x:Double x:Key="VfStateDisabledOpacity">0.46</x:Double>
  <x:Double x:Key="VfMotionFastMs">120</x:Double>
  <x:Double x:Key="VfMotionBaseMs">160</x:Double>
