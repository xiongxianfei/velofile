  <Color x:Key="VfColorSuccess">#82E084</Color>
  <SolidColorBrush x:Key="VfBrushSuccess" Color="{StaticResource VfColorSuccess}" />

  <FontFamily x:Key="VfFontUi">Segoe UI Variable, Segoe UI, system-ui, sans-serif</FontFamily>
  <FontFamily x:Key="VfFontMono">Cascadia Mono, Consolas, monospace</FontFamily>
  <x:Double x:Key="VfTextSizeXs">10</x:Double>
  <x:Double x:Key="VfTextSizeSm">11</x:Double>
  <x:Double x:Key="VfTextSizeBase">12.5</x:Double>
  <x:Double x:Key="VfTextSizeMd">13</x:Double>
  <x:Double x:Key="VfTextSizeLg">14</x:Double>
