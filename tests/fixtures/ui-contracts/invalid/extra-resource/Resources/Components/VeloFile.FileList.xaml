<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="VfFileListItemContainerStyle" TargetType="ListViewItem">
    <Setter Property="MinHeight" Value="{StaticResource VfFileListRowHeight}" />
    <Setter Property="Padding" Value="{StaticResource VfDensityRowPaddingX}" />
  </Style>
  <DataTemplate x:Key="VfFileListRowTemplate">
    <Grid MinHeight="{StaticResource VfFileListRowHeight}">
      <TextBlock Style="{StaticResource VfFileListRowNameTextStyle}" />
      <TextBlock Style="{StaticResource VfFileListRowMetadataTextStyle}" />
    </Grid>
  </DataTemplate>
  <Style x:Key="VfFileListRowNameTextStyle" TargetType="TextBlock" />
  <Style x:Key="VfFileListRowMetadataTextStyle" TargetType="TextBlock" />
  <x:Double x:Key="VfFileListUnapprovedGap">7</x:Double>
</ResourceDictionary>
