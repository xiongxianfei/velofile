<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StaticResource x:Key="VfStatusSurfaceBrush" ResourceKey="VfShellContentBackgroundBrush" />
  <StaticResource x:Key="VfStatusBorderBrush" ResourceKey="VfShellSeparatorBrush" />
  <StaticResource x:Key="VfStatusTextBrush" ResourceKey="VfShellTextSecondaryBrush" />
  <StaticResource x:Key="VfStatusMutedTextBrush" ResourceKey="VfShellTextMutedBrush" />
  <StaticResource x:Key="VfStatusFailureTextBrush" ResourceKey="VfShellDangerBrush" />
  <StaticResource x:Key="VfStatusFocusBrush" ResourceKey="VfShellFocusBrush" />
  <StaticResource x:Key="VfStatusFocusThickness" ResourceKey="VfShellFocusThickness" />
  <Thickness x:Key="VfStatusSurfacePadding">10,6</Thickness>
  <Thickness x:Key="VfStatusSurfaceBorderThickness">1,0,0,0</Thickness>
  <Thickness x:Key="VfStatusSurfaceMargin">0,8,0,0</Thickness>
  <Thickness x:Key="VfStatusMessageSpacing">0,6,0,0</Thickness>
  <Style x:Key="VfStatusSurfaceStyle" TargetType="Border" />
  <Style x:Key="VfStatusTextStyle" TargetType="TextBlock" />
  <Style x:Key="VfStatusMutedTextStyle" TargetType="TextBlock" />
  <Style x:Key="VfStatusFailureTextStyle" TargetType="TextBlock" />
</ResourceDictionary>
