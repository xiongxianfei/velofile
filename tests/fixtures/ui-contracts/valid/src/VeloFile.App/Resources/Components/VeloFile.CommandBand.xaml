<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StaticResource x:Key="VfCommandBandSurfaceBrush" ResourceKey="VfShellRootBackgroundBrush" />
  <StaticResource x:Key="VfCommandBandButtonBackgroundBrush" ResourceKey="VfShellControlBackgroundBrush" />
  <StaticResource x:Key="VfCommandBandButtonHoverBackgroundBrush" ResourceKey="VfShellControlHoverBackgroundBrush" />
  <StaticResource x:Key="VfCommandBandButtonPressedBackgroundBrush" ResourceKey="VfShellSelectionBrush" />
  <StaticResource x:Key="VfCommandBandButtonDisabledBackgroundBrush" ResourceKey="VfShellControlDisabledBackgroundBrush" />
  <StaticResource x:Key="VfCommandBandButtonForegroundBrush" ResourceKey="VfShellControlForegroundBrush" />
  <StaticResource x:Key="VfCommandBandButtonDisabledForegroundBrush" ResourceKey="VfShellControlDisabledForegroundBrush" />
  <StaticResource x:Key="VfCommandBandButtonBorderBrush" ResourceKey="VfShellControlBorderBrush" />
  <StaticResource x:Key="VfCommandBandInputBackgroundBrush" ResourceKey="VfShellControlBackgroundBrush" />
  <StaticResource x:Key="VfCommandBandInputForegroundBrush" ResourceKey="VfShellControlForegroundBrush" />
  <StaticResource x:Key="VfCommandBandInputPlaceholderBrush" ResourceKey="VfShellTextMutedBrush" />
  <StaticResource x:Key="VfCommandBandInputBorderBrush" ResourceKey="VfShellControlBorderBrush" />
  <StaticResource x:Key="VfCommandBandInputFocusBorderBrush" ResourceKey="VfShellAccentBrush" />
  <StaticResource x:Key="VfCommandBandStatusTextBrush" ResourceKey="VfShellTextMutedBrush" />
  <StaticResource x:Key="VfCommandBandFocusBrush" ResourceKey="VfShellFocusBrush" />
  <StaticResource x:Key="VfCommandBandFocusThickness" ResourceKey="VfShellFocusThickness" />
  <StaticResource x:Key="VfCommandBandDisabledOpacity" ResourceKey="VfShellDisabledOpacity" />
  <StaticResource x:Key="VfCommandBandControlHeight" ResourceKey="VfSizeBreadcrumbHeight" />
  <StaticResource x:Key="VfCommandBandIconButtonWidth" ResourceKey="VfSizeBreadcrumbHeight" />
  <StaticResource x:Key="VfCommandBandIconSize" ResourceKey="VfSizeIconMd" />
  <StaticResource x:Key="VfCommandBandControlRadius" ResourceKey="VfRadiusBase" />
  <StaticResource x:Key="VfCommandBandGroupSpacing" ResourceKey="VfSpace1" />
  <StaticResource x:Key="VfCommandBandColumnSpacing" ResourceKey="VfSpace2" />
  <StaticResource x:Key="VfCommandBandRowSpacing" ResourceKey="VfSpace2" />
  <Thickness x:Key="VfCommandBandOuterMargin">12,8,12,8</Thickness>
  <Thickness x:Key="VfCommandBandPathMargin">12,0</Thickness>
  <Thickness x:Key="VfCommandBandBreadcrumbMargin">8,0,0,0</Thickness>
  <Thickness x:Key="VfCommandBandFilterSearchMargin">0,8,0,0</Thickness>
  <Thickness x:Key="VfCommandBandSkippedLocationsMargin">0,6,0,0</Thickness>
  <Thickness x:Key="VfCommandBandSkippedLocationRowPadding">4,2</Thickness>
  <Thickness x:Key="VfCommandBandControlPadding">10,5</Thickness>
  <Thickness x:Key="VfCommandBandIconButtonPadding">0</Thickness>
  <Thickness x:Key="VfCommandBandBreadcrumbPadding">10,5</Thickness>
  <x:Double x:Key="VfCommandBandStatusTextOpacity">0.72</x:Double>
  <Style x:Key="VfCommandBandContainerStyle" TargetType="Grid">
    <Setter Property="MinHeight" Value="{StaticResource VfCommandBandControlHeight}" />
  </Style>
  <Style x:Key="VfCommandBandSearchContainerStyle" TargetType="Grid" />
  <Style x:Key="VfCommandBandNavigationGroupStyle" TargetType="StackPanel" />
  <Style x:Key="VfCommandBandSearchGroupStyle" TargetType="StackPanel" />
  <Style x:Key="VfCommandBandButtonStyle" TargetType="Button">
    <Setter Property="MinHeight" Value="{StaticResource VfCommandBandControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource VfCommandBandControlPadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource VfCommandBandControlRadius}" />
  </Style>
  <Style x:Key="VfCommandBandIconButtonStyle" TargetType="Button" BasedOn="{StaticResource VfCommandBandButtonStyle}" />
  <Style x:Key="VfCommandBandBreadcrumbButtonStyle" TargetType="Button" BasedOn="{StaticResource VfCommandBandButtonStyle}" />
  <Style x:Key="VfCommandBandInputStyle" TargetType="TextBox">
    <Setter Property="MinHeight" Value="{StaticResource VfCommandBandControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource VfCommandBandControlPadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource VfCommandBandControlRadius}" />
  </Style>
  <Style x:Key="VfCommandBandPathStyle" TargetType="TextBox" BasedOn="{StaticResource VfCommandBandInputStyle}" />
  <Style x:Key="VfCommandBandPathListStyle" TargetType="ListView" />
  <Style x:Key="VfCommandBandViewModeGroupStyle" TargetType="StackPanel" />
  <Style x:Key="VfCommandBandRadioButtonStyle" TargetType="RadioButton" />
  <Style x:Key="VfCommandBandStatusTextStyle" TargetType="TextBlock">
    <Setter Property="Opacity" Value="{StaticResource VfCommandBandStatusTextOpacity}" />
  </Style>
  <Style x:Key="VfCommandBandSkippedLocationTextStyle" TargetType="TextBlock" />
</ResourceDictionary>
