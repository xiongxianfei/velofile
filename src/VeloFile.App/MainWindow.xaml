<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VeloFile.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="VeloFile">
    <Grid
        x:Name="RootShell"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="ForwardAccelerator_Invoked" />
            <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="UpAccelerator_Invoked" />
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="NewTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CloseTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="T" Modifiers="Control,Shift" Invoked="ReopenClosedTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="NextTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control,Shift" Invoked="PreviousTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="FocusPathAccelerator_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="TogglePreviewAccelerator_Invoked" />
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="ClearSelectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Enter" Invoked="OpenAccelerator_Invoked" />
            <KeyboardAccelerator Key="F2" Invoked="RenameAccelerator_Invoked" />
            <KeyboardAccelerator Key="Delete" Invoked="DeleteAccelerator_Invoked" />
            <KeyboardAccelerator Key="Delete" Modifiers="Shift" Invoked="PermanentDeleteAccelerator_Invoked" />
            <KeyboardAccelerator Key="Back" Invoked="ParentFolderAccelerator_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="CopyPathAccelerator_Invoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control,Shift" Invoked="CopyNameAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="PreviewColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="TabStrip"
            Grid.Row="0"
            Grid.ColumnSpan="3"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListView
                    x:Name="TabList"
                    Margin="8,4"
                    IsItemClickEnabled="False"
                    SelectionMode="Single"
                    SelectionChanged="TabList_SelectionChanged"
                    AutomationProperties.Name="Tabs">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                MinWidth="140"
                                Padding="8,4"
                                Text="{Binding Path}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="0,6,8,6"
                    Spacing="4">
                    <Button
                        Width="36"
                        ToolTipService.ToolTip="Previous tab"
                        Click="PreviousTabButton_Click"
                        AutomationProperties.Name="Previous tab">
                        <Viewbox
                            Width="16"
                            Height="16">
                            <Path
                                Data="M 12.7,4.3 L 5,12 L 12.7,19.7 L 14.1,18.3 L 7.8,12 L 14.1,5.7 Z"
                                Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                    <Button
                        Width="36"
                        ToolTipService.ToolTip="Next tab"
                        Click="NextTabButton_Click"
                        AutomationProperties.Name="Next tab">
                        <Viewbox
                            Width="16"
                            Height="16">
                            <Path
                                Data="M 7.3,4.3 L 15,12 L 7.3,19.7 L 5.9,18.3 L 12.2,12 L 5.9,5.7 Z"
                                Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                    <Button
                        Width="36"
                        ToolTipService.ToolTip="New tab"
                        Click="NewTabButton_Click"
                        AutomationProperties.Name="New tab">
                        <Viewbox Width="16" Height="16">
                            <Path
                                Data="M 10,4 L 14,4 L 14,10 L 20,10 L 20,14 L 14,14 L 14,20 L 10,20 L 10,14 L 4,14 L 4,10 L 10,10 Z"
                                Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                    <Button
                        Width="36"
                        ToolTipService.ToolTip="Duplicate tab"
                        Click="DuplicateTabButton_Click"
                        AutomationProperties.Name="Duplicate tab">
                        <Viewbox Width="16" Height="16">
                            <Path
                                Data="M 7,3 L 19,3 L 19,15 L 17,15 L 17,5 L 7,5 Z M 5,7 L 15,7 L 15,19 L 5,19 Z M 7,9 L 7,17 L 13,17 L 13,9 Z"
                                Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                    <Button
                        Width="36"
                        ToolTipService.ToolTip="Close tab"
                        Click="CloseTabButton_Click"
                        AutomationProperties.Name="Close tab">
                        <Viewbox Width="16" Height="16">
                            <Path
                                Data="M 6.2,4.8 L 12,10.6 L 17.8,4.8 L 19.2,6.2 L 13.4,12 L 19.2,17.8 L 17.8,19.2 L 12,13.4 L 6.2,19.2 L 4.8,17.8 L 10.6,12 L 4.8,6.2 Z"
                                Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                    <Button
                        Width="36"
                        ToolTipService.ToolTip="Reopen closed tab"
                        Click="ReopenClosedTabButton_Click"
                        AutomationProperties.Name="Reopen closed tab">
                        <Viewbox Width="16" Height="16">
                            <Path
                                Data="M 18.7,7.1 C 17.2,5.2 14.8,4 12,4 C 7.6,4 4,7.2 4,11.2 C 4,15.6 7.6,19 12,19 C 15.4,19 18.3,16.9 19.4,13.9 L 17.3,13.9 C 16.4,15.8 14.4,17 12,17 C 8.7,17 6,14.5 6,11.2 C 6,8.4 8.7,6 12,6 C 14.2,6 16.1,6.9 17.2,8.4 L 14,8.4 L 14,10.4 L 20,10.4 L 20,4.4 L 18,4.4 L 18,7.1 Z"
                                Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="NavigationButtons"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="4">
                <Button Width="36" ToolTipService.ToolTip="Back" Click="BackButton_Click" AutomationProperties.Name="Back">
                    <Viewbox Width="16" Height="16">
                        <Path
                            Data="M 12.7,4.3 L 5,12 L 12.7,19.7 L 14.1,18.3 L 7.8,12 L 14.1,5.7 Z"
                            Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            Stretch="Uniform" />
                    </Viewbox>
                </Button>
                <Button Width="36" ToolTipService.ToolTip="Forward" Click="ForwardButton_Click" AutomationProperties.Name="Forward">
                    <Viewbox Width="16" Height="16">
                        <Path
                            Data="M 7.3,4.3 L 15,12 L 7.3,19.7 L 5.9,18.3 L 12.2,12 L 5.9,5.7 Z"
                            Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            Stretch="Uniform" />
                    </Viewbox>
                </Button>
                <Button Width="36" ToolTipService.ToolTip="Up" Click="UpButton_Click" AutomationProperties.Name="Parent folder">
                    <Viewbox Width="16" Height="16">
                        <Path
                            Data="M 12,5 L 19.7,12.7 L 18.3,14.1 L 13,8.8 L 13,20 L 11,20 L 11,8.8 L 5.7,14.1 L 4.3,12.7 Z"
                            Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            Stretch="Uniform" />
                    </Viewbox>
                </Button>
                <Button Width="36" ToolTipService.ToolTip="Refresh" Click="RefreshButton_Click" AutomationProperties.Name="Refresh">
                    <Viewbox Width="16" Height="16">
                        <Path
                            Data="M 18.7,7.1 C 17.2,5.2 14.8,4 12,4 C 7.6,4 4,7.2 4,11.2 C 4,15.6 7.6,19 12,19 C 15.4,19 18.3,16.9 19.4,13.9 L 17.3,13.9 C 16.4,15.8 14.4,17 12,17 C 8.7,17 6,14.5 6,11.2 C 6,8.4 8.7,6 12,6 C 14.2,6 16.1,6.9 17.2,8.4 L 14,8.4 L 14,10.4 L 20,10.4 L 20,4.4 L 18,4.4 L 18,7.1 Z"
                            Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            Stretch="Uniform" />
                    </Viewbox>
                </Button>
            </StackPanel>

            <ListView
                x:Name="BreadcrumbPathBar"
                Grid.Column="1"
                Margin="8,0,0,0"
                IsItemClickEnabled="True"
                ItemClick="BreadcrumbPathBar_ItemClick"
                SelectionMode="None"
                AutomationProperties.Name="Breadcrumb path">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Content="{Binding DisplayName}"
                            Padding="8,4"
                            AutomationProperties.Name="{Binding DisplayName}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBox
                x:Name="RawPathBox"
                Grid.Column="2"
                Margin="12,0"
                KeyDown="RawPathBox_KeyDown"
                PlaceholderText="Type or paste a path"
                AutomationProperties.Name="Raw path" />

            <StackPanel
                x:Name="FileViewModeSelector"
                Grid.Column="3"
                Orientation="Horizontal"
                Spacing="4"
                AutomationProperties.Name="File view mode">
                <RadioButton Content="Details" IsChecked="True" />
                <RadioButton Content="List" />
                <RadioButton Content="Icons" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="SidebarPane"
            Grid.Row="1"
            Grid.RowSpan="3"
            Grid.Column="0"
            Padding="12,8"
            BorderThickness="0,0,1,0"
            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="VisibilityControls" Spacing="6">
                    <ToggleSwitch
                        x:Name="ShowHiddenFilesToggle"
                        Header="Hidden"
                        AccessKey="H"
                        Toggled="ShowHiddenFilesToggle_Toggled"
                        AutomationProperties.Name="Show hidden files" />
                    <ToggleSwitch
                        x:Name="ShowSystemFilesToggle"
                        Header="System"
                        AccessKey="S"
                        Toggled="ShowSystemFilesToggle_Toggled"
                        AutomationProperties.Name="Show protected operating system files" />
                    <ToggleSwitch
                        x:Name="ShowExtensionsToggle"
                        Header="Extensions"
                        AccessKey="E"
                        Toggled="ShowExtensionsToggle_Toggled"
                        AutomationProperties.Name="Show file extensions" />
                    <ComboBox
                        x:Name="TerminalTargetComboBox"
                        Header="Terminal"
                        PlaceholderText="Default terminal"
                        DropDownOpened="TerminalTargetComboBox_DropDownOpened"
                        SelectionChanged="TerminalTargetComboBox_SelectionChanged"
                        AutomationProperties.Name="Terminal target">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <ListView
                    x:Name="SidebarLocationsList"
                    Grid.Row="1"
                    Margin="0,14,0,0"
                    IsItemClickEnabled="True"
                    ItemClick="SidebarLocationsList_ItemClick"
                    SelectionMode="Single"
                    AutomationProperties.Name="Sidebar locations">
                    <ListView.Header>
                        <TextBlock Text="Locations" />
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Grid.Row="2"
                    Text="Ready"
                    Opacity="0.7" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="2"
            Grid.Column="1"
            Margin="12,0,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <InfoBar
                x:Name="CrashRecoveryState"
                Grid.Row="0"
                IsOpen="False"
                Severity="Warning"
                Title="Recovered after a previous crash"
                Message="You can start fresh if restored state keeps causing failures.">
                <InfoBar.ActionButton>
                    <Button Content="Start fresh" Click="StartFreshButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Name="MissingLocationState"
                Grid.Row="1"
                IsOpen="False"
                Severity="Warning"
                Title="Location unavailable"
                Message="The restored path is no longer available.">
                <InfoBar.ActionButton>
                    <Button Content="Close tab" Click="CloseMissingLocationTabButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Name="PathEntryFailureState"
                Grid.Row="2"
                IsOpen="False"
                Severity="Warning"
                Title="Path not opened"
                Message="The submitted path could not be opened.">
                <InfoBar.ActionButton>
                    <Button Content="Clear" Click="ClearPathEntryErrorButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- ui-contract-scope:file-list-first-slice:start -->
            <ListView
                x:Name="FileListSurface"
                Grid.Row="4"
                Margin="0,8,0,0"
                AllowDrop="True"
                DragOver="FileListSurface_DragOver"
                DragLeave="FileListSurface_DragLeave"
                Drop="FileListSurface_Drop"
                DoubleTapped="FileListSurface_DoubleTapped"
                ItemContainerStyle="{StaticResource VfFileListItemContainerStyle}"
                ItemTemplate="{StaticResource VfFileListRowTemplate}"
                SelectionMode="Extended"
                SelectionChanged="FileListSurface_SelectionChanged"
                AutomationProperties.Name="Files">
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackground" Color="{Binding Color, Source={StaticResource VfFileListRowBackground}}" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{Binding Color, Source={StaticResource VfFileListRowHoverBackground}}" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{Binding Color, Source={StaticResource VfFileListRowSelectedBackground}}" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{Binding Color, Source={StaticResource VfFileListRowSelectedBackground}}" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{Binding Color, Source={StaticResource VfFileListRowSelectedBackground}}" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="{Binding Color, Source={StaticResource VfFileListRowSelectedBackground}}" />
                </ListView.Resources>
                <ListView.ContextFlyout>
                    <MenuFlyout x:Name="BuiltInFileContextMenu" Opening="BuiltInFileContextMenu_Opening">
                        <MenuFlyoutItem x:Name="OpenMenuItem" Text="Open" Click="OpenMenuItem_Click" />
                        <MenuFlyoutItem x:Name="OpenWithMenuItem" Text="Open with" Click="OpenWithMenuItem_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="CutMenuItem" Text="Cut" Click="CutMenuItem_Click" />
                        <MenuFlyoutItem x:Name="CopyMenuItem" Text="Copy" Click="CopyMenuItem_Click" />
                        <MenuFlyoutItem x:Name="PasteMenuItem" Text="Paste" Click="PasteMenuItem_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="RenameMenuItem" Text="Rename" Click="RenameMenuItem_Click" />
                        <MenuFlyoutItem x:Name="DeleteMenuItem" Text="Delete" Click="DeleteMenuItem_Click" />
                        <MenuFlyoutItem x:Name="PropertiesMenuItem" Text="Properties" Click="PropertiesMenuItem_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="CopyPathMenuItem" Text="Copy path" Click="CopyPathMenuItem_Click" />
                        <MenuFlyoutItem x:Name="CopyNameMenuItem" Text="Copy name" Click="CopyNameMenuItem_Click" />
                        <MenuFlyoutItem x:Name="OpenTerminalMenuItem" Text="Open terminal here" Click="OpenTerminalMenuItem_Click" />
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>
            <!-- ui-contract-scope:file-list-first-slice:end -->

            <Grid
                x:Name="FilterSearchSurface"
                Grid.Row="3"
                Margin="0,8,0,0"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="CurrentFolderFilterBox"
                    PlaceholderText="Filter"
                    TextChanged="CurrentFolderFilterBox_TextChanged"
                    AutomationProperties.Name="Current folder filter" />
                <TextBox
                    x:Name="RecursiveSearchBox"
                    Grid.Column="1"
                    PlaceholderText="Search"
                    KeyDown="RecursiveSearchBox_KeyDown"
                    AutomationProperties.Name="Recursive search" />
                <Button
                    x:Name="RecursiveSearchButton"
                    Grid.Column="2"
                    Content="Search"
                    Click="RecursiveSearchButton_Click"
                    AutomationProperties.Name="Run recursive search" />
                <Button
                    x:Name="CancelSearchButton"
                    Grid.Column="3"
                    Content="Cancel"
                    Click="CancelSearchButton_Click"
                    AutomationProperties.Name="Cancel recursive search" />
                <Button
                    x:Name="ClearSearchButton"
                    Grid.Column="4"
                    Content="Clear"
                    Click="ClearSearchButton_Click"
                    AutomationProperties.Name="Clear recursive search" />
                <TextBlock
                    x:Name="RecursiveSearchStatusText"
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Opacity="0.72" />
                <ListView
                    x:Name="SkippedLocationsList"
                    Grid.Row="1"
                    Grid.ColumnSpan="6"
                    Margin="0,6,0,0"
                    MaxHeight="96"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Skipped search locations">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ReasonCode}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Path}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel
                    x:Name="RenamePanel"
                    Grid.Row="2"
                    Grid.ColumnSpan="6"
                    Margin="0,6,0,0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="RenameTextBox"
                        Width="260"
                        TextChanged="RenameTextBox_TextChanged"
                        KeyDown="RenameTextBox_KeyDown"
                        AutomationProperties.Name="Rename item" />
                    <Button
                        x:Name="CommitRenameButton"
                        Content="Rename"
                        Click="CommitRenameButton_Click"
                        AutomationProperties.Name="Commit rename" />
                    <Button
                        x:Name="CancelRenameButton"
                        Content="Cancel"
                        Click="CancelRenameButton_Click"
                        AutomationProperties.Name="Cancel rename" />
                    <TextBlock
                        x:Name="RenameErrorText"
                        VerticalAlignment="Center"
                        Opacity="0.75" />
                </StackPanel>
                <StackPanel
                    x:Name="PermanentDeleteConfirmationPanel"
                    Grid.Row="3"
                    Grid.ColumnSpan="6"
                    Margin="0,6,0,0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="PermanentDeleteConfirmationText"
                        VerticalAlignment="Center"
                        Text="Permanently delete selected items?" />
                    <Button
                        x:Name="ConfirmPermanentDeleteButton"
                        Content="Delete permanently"
                        Click="ConfirmPermanentDeleteButton_Click"
                        AutomationProperties.Name="Confirm permanent delete" />
                    <Button
                        x:Name="CancelPermanentDeleteButton"
                        Content="Cancel"
                        Click="CancelPermanentDeleteButton_Click"
                        AutomationProperties.Name="Cancel permanent delete" />
                </StackPanel>
                <StackPanel
                    x:Name="FileOperationConflictPanel"
                    Grid.Row="4"
                    Grid.ColumnSpan="6"
                    Margin="0,6,0,0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="FileOperationConflictText"
                        VerticalAlignment="Center"
                        Text="Name conflict" />
                    <Button
                        x:Name="SkipConflictButton"
                        Content="Skip"
                        Click="SkipConflictButton_Click"
                        AutomationProperties.Name="Skip conflict" />
                    <Button
                        x:Name="ReplaceConflictButton"
                        Content="Replace"
                        Click="ReplaceConflictButton_Click"
                        AutomationProperties.Name="Replace conflict" />
                    <Button
                        x:Name="KeepBothConflictButton"
                        Content="Keep both"
                        Click="KeepBothConflictButton_Click"
                        AutomationProperties.Name="Keep both conflict" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="5" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="LoadingState"
                    Text="Loading"
                    Opacity="0.75" />
                <TextBlock
                    x:Name="EmptyFolderState"
                    Grid.Column="1"
                    Text="Empty folder"
                    Opacity="0.75" />
                <TextBlock
                    x:Name="FailedState"
                    Grid.Column="2"
                    Text="Unable to open location"
                    Opacity="0.75" />
                <StackPanel
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Margin="0,6,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        x:Name="FileOperationStatusText"
                        VerticalAlignment="Center"
                        Opacity="0.75" />
                    <TextBlock
                        x:Name="LaunchStatusText"
                        VerticalAlignment="Center"
                        Opacity="0.75" />
                    <TextBlock
                        x:Name="DropActionIndicatorText"
                        VerticalAlignment="Center"
                        Opacity="0.75"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="CancelFileOperationButton"
                        Content="Cancel operation"
                        Click="CancelFileOperationButton_Click"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Cancel file operation" />
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock
            Grid.Row="3"
            Grid.Column="1"
            Margin="12,0"
            VerticalAlignment="Center"
            Text="0 items selected"
            Opacity="0.7" />

        <Border
            x:Name="PreviewPane"
            Grid.Row="1"
            Grid.RowSpan="3"
            Grid.Column="2"
            Padding="12,8"
            BorderThickness="1,0,0,0"
            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
            Visibility="Collapsed"
            AutomationProperties.Name="Preview pane">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="Preview"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="PreviewStatusText"
                    Grid.Row="1"
                    Text="Preview unavailable"
                    Opacity="0.75" />
                <StackPanel
                    Grid.Row="2"
                    Spacing="6">
                    <TextBlock
                        x:Name="PreviewContentText"
                        TextWrapping="WrapWholeWords"
                        TextTrimming="CharacterEllipsis"
                        AutomationProperties.Name="Preview content" />
                    <StackPanel
                        x:Name="PdfPageNavigationPanel"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed"
                        AutomationProperties.Name="PDF page navigation">
                        <Button
                            x:Name="PdfPreviousPageButton"
                            Content="Previous"
                            Click="PdfPreviousPageButton_Click"
                            AutomationProperties.Name="Previous PDF page" />
                        <TextBlock
                            x:Name="PdfPageIndicatorText"
                            VerticalAlignment="Center"
                            Opacity="0.75" />
                        <Button
                            x:Name="PdfNextPageButton"
                            Content="Next"
                            Click="PdfNextPageButton_Click"
                            AutomationProperties.Name="Next PDF page" />
                    </StackPanel>
                    <Image
                        x:Name="PreviewImageSurface"
                        MaxHeight="240"
                        Stretch="Uniform"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Rendered preview" />
                </StackPanel>
                <ListView
                    x:Name="PreviewMetadataList"
                    Grid.Row="3"
                    AutomationProperties.Name="Preview metadata">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,3" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Opacity="0.72" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Value}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>
