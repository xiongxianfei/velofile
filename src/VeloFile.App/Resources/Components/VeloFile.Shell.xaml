<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="VfShellSeparatorBrush" ResourceKey="VfBrushBorderSubtle" />
    <StaticResource x:Key="VfShellFocusBrush" ResourceKey="VfFocusBrush" />
    <StaticResource x:Key="VfShellAccentBrush" ResourceKey="VfBrushAccent" />
    <StaticResource x:Key="VfShellElevatedBrush" ResourceKey="VfBrushSurfaceElevated" />
    <StaticResource x:Key="VfShellSelectionBrush" ResourceKey="VfBrushSurfaceSelected" />
    <StaticResource x:Key="VfShellHoverBrush" ResourceKey="VfBrushSurfaceHover" />
    <StaticResource x:Key="VfShellDangerBrush" ResourceKey="VfBrushDanger" />
    <StaticResource x:Key="VfShellWarningBrush" ResourceKey="VfBrushWarning" />
    <StaticResource x:Key="VfShellSuccessBrush" ResourceKey="VfBrushSuccess" />
    <StaticResource x:Key="VfShellDisabledOpacity" ResourceKey="VfStateDisabledOpacity" />

    <Style x:Key="VfShellAppRootStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource VfBrushSurfaceApp}" />
    </Style>

    <Style x:Key="VfShellChromeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VfBrushSurfaceChrome}" />
        <Setter Property="BorderBrush" Value="{StaticResource VfShellSeparatorBrush}" />
    </Style>

    <Style x:Key="VfShellSidebarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VfBrushSurfaceSidebar}" />
        <Setter Property="BorderBrush" Value="{StaticResource VfShellSeparatorBrush}" />
    </Style>

    <Style x:Key="VfShellContentStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource VfBrushSurfaceContent}" />
    </Style>

    <Style x:Key="VfShellCommandBandContainerStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource VfBrushSurfaceApp}" />
    </Style>

    <Style x:Key="VfShellStatusContainerStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource VfBrushSurfaceContent}" />
    </Style>

    <Style x:Key="VfShellPreviewContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VfBrushSurfaceSidebar}" />
        <Setter Property="BorderBrush" Value="{StaticResource VfShellSeparatorBrush}" />
    </Style>

    <Style x:Key="VfShellPrimaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeMd}" />
        <Setter Property="Foreground" Value="{StaticResource VfBrushTextPrimary}" />
    </Style>

    <Style x:Key="VfShellSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource VfBrushTextSecondary}" />
    </Style>

    <Style x:Key="VfShellMutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeSm}" />
        <Setter Property="Foreground" Value="{StaticResource VfBrushTextMuted}" />
    </Style>
</ResourceDictionary>
