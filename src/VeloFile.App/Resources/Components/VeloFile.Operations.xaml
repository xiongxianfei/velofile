<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="VfOperationSurfaceBrush" ResourceKey="VfShellElevatedBackgroundBrush" />
    <StaticResource x:Key="VfOperationBorderBrush" ResourceKey="VfShellSeparatorBrush" />
    <StaticResource x:Key="VfOperationTextBrush" ResourceKey="VfShellTextPrimaryBrush" />
    <StaticResource x:Key="VfOperationMutedTextBrush" ResourceKey="VfShellTextMutedBrush" />
    <StaticResource x:Key="VfOperationProgressBrush" ResourceKey="VfShellAccentBrush" />
    <StaticResource x:Key="VfOperationCompletedBrush" ResourceKey="VfShellSuccessBrush" />
    <StaticResource x:Key="VfOperationCancelledBrush" ResourceKey="VfShellWarningBrush" />
    <StaticResource x:Key="VfOperationFailureBrush" ResourceKey="VfShellDangerBrush" />
    <StaticResource x:Key="VfOperationConflictBrush" ResourceKey="VfShellWarningBrush" />
    <StaticResource x:Key="VfOperationDangerBrush" ResourceKey="VfShellDangerBrush" />
    <StaticResource x:Key="VfOperationDangerForegroundBrush" ResourceKey="VfBrushAccentOnAccent" />
    <StaticResource x:Key="VfOperationFocusBrush" ResourceKey="VfShellFocusBrush" />
    <StaticResource x:Key="VfOperationFocusThickness" ResourceKey="VfShellFocusThickness" />
    <StaticResource x:Key="VfOperationDisabledOpacity" ResourceKey="VfShellDisabledOpacity" />
    <Thickness x:Key="VfOperationSurfacePadding">10,8</Thickness>
    <Thickness x:Key="VfOperationSurfaceBorderThickness">1</Thickness>
    <Thickness x:Key="VfOperationSurfaceMargin">0,6,0,0</Thickness>
    <CornerRadius x:Key="VfOperationSurfaceRadius">6</CornerRadius>
    <x:Double x:Key="VfOperationPanelSpacing">8</x:Double>

    <Style x:Key="VfOperationSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VfOperationSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VfOperationBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource VfOperationSurfaceBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource VfOperationSurfaceRadius}" />
        <Setter Property="Padding" Value="{StaticResource VfOperationSurfacePadding}" />
        <Setter Property="Margin" Value="{StaticResource VfOperationSurfaceMargin}" />
    </Style>

    <Style x:Key="VfOperationProgressStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource VfOperationProgressBrush}" />
    </Style>

    <Style x:Key="VfOperationCompletedStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource VfOperationCompletedBrush}" />
    </Style>

    <Style x:Key="VfOperationCancelledStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource VfOperationCancelledBrush}" />
    </Style>

    <Style x:Key="VfOperationFailureStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource VfOperationFailureBrush}" />
    </Style>

    <Style x:Key="VfOperationConflictStatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource VfOperationConflictBrush}" />
    </Style>

    <Style x:Key="VfDestructiveStatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource VfOperationDangerBrush}" />
    </Style>

    <Style x:Key="VfOperationConflictStyle" TargetType="Border" BasedOn="{StaticResource VfOperationSurfaceStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource VfOperationConflictBrush}" />
    </Style>

    <Style x:Key="VfDestructiveConfirmationStyle" TargetType="Border" BasedOn="{StaticResource VfOperationSurfaceStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource VfOperationDangerBrush}" />
    </Style>

    <Style x:Key="VfDestructiveConfirmationTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource VfOperationDangerBrush}" />
    </Style>

    <Style x:Key="VfDestructiveActionButtonStyle" TargetType="Button" BasedOn="{StaticResource VfShellButtonStyle}">
        <Setter Property="Background" Value="{StaticResource VfOperationDangerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VfOperationDangerForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VfOperationDangerBrush}" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource VfOperationFocusBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource VfOperationFocusThickness}" />
    </Style>

    <Style x:Key="VfOperationCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource VfShellButtonStyle}">
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource VfOperationFocusBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource VfOperationFocusThickness}" />
    </Style>

    <Style x:Key="VfOperationSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource VfShellButtonStyle}">
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource VfOperationFocusBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource VfOperationFocusThickness}" />
    </Style>
</ResourceDictionary>
