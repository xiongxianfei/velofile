<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:VeloFile.App.Ui">
    <Thickness x:Key="VfFileListRowPadding">12,6</Thickness>
    <Thickness x:Key="VfFileListHeaderPadding">12,0,12,6</Thickness>
    <SolidColorBrush x:Key="VfFileListRowBackground" Color="{StaticResource VfColorSurfaceContent}" />
    <SolidColorBrush x:Key="VfFileListRowHoverBackground" Color="{StaticResource VfColorSurfaceHover}" />
    <SolidColorBrush x:Key="VfFileListRowSelectedBackground" Color="{StaticResource VfColorSurfaceSelected}" />
    <SolidColorBrush x:Key="VfFileListRowFocusedBorderBrush" Color="{StaticResource VfColorAccentLine}" />
    <Thickness x:Key="VfFileListRowFocusedBorderThickness">2</Thickness>
    <SolidColorBrush x:Key="VfFileListRowSelectedFocusedBorderBrush" Color="{StaticResource VfColorAccentLine}" />
    <Thickness x:Key="VfFileListRowSelectedFocusedBorderThickness">2</Thickness>
    <StaticResource x:Key="VfFileListRowHiddenOpacity" ResourceKey="VfStateHiddenOpacity" />
    <StaticResource x:Key="VfFileListRowProtectedOpacity" ResourceKey="VfStateHiddenOpacity" />
    <ui:FileListRowOpacityConverter
        x:Key="VfFileListRowOpacityConverter"
        HiddenOpacity="{StaticResource VfFileListRowHiddenOpacity}"
        ProtectedOpacity="{StaticResource VfFileListRowProtectedOpacity}" />

    <Style x:Key="VfFileListItemContainerStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="{StaticResource VfFileListRowHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource VfFileListRowFocusedBorderBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource VfFileListRowFocusedBorderThickness}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource VfFileListRowSelectedFocusedBorderBrush}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="{StaticResource VfFileListRowSelectedFocusedBorderThickness}" />
    </Style>

    <Style x:Key="VfFileListRowNameTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource VfBrushTextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="VfFileListRowMetadataTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeSm}" />
        <Setter Property="Foreground" Value="{StaticResource VfBrushTextMuted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="VfFileListHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeXs}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource VfBrushTextMuted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="VfFileListRowTemplate">
        <Grid
            MinHeight="{StaticResource VfFileListRowHeight}"
            Padding="{StaticResource VfFileListRowPadding}"
            ColumnSpacing="{StaticResource VfSpace3}"
            Opacity="{Binding Converter={StaticResource VfFileListRowOpacityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <ContentControl
                Content="{Binding IconKind}"
                ContentTemplate="{StaticResource VfFileListFixtureIconTemplate}" />
            <TextBlock
                Grid.Column="1"
                Style="{StaticResource VfFileListRowNameTextStyle}"
                Text="{Binding DisplayName}" />
            <TextBlock
                Grid.Column="2"
                Style="{StaticResource VfFileListRowMetadataTextStyle}"
                Text="{Binding Kind}" />
            <TextBlock
                Grid.Column="3"
                Style="{StaticResource VfFileListRowMetadataTextStyle}"
                Text="{Binding LastWriteTimeUtc}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
