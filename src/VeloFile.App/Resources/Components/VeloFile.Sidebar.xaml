<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="VfSidebarSurfaceBrush" ResourceKey="VfShellSidebarBackgroundBrush" />
    <StaticResource x:Key="VfSidebarTextPrimaryBrush" ResourceKey="VfShellTextPrimaryBrush" />
    <StaticResource x:Key="VfSidebarTextSecondaryBrush" ResourceKey="VfShellTextSecondaryBrush" />
    <StaticResource x:Key="VfSidebarTextMutedBrush" ResourceKey="VfShellTextMutedBrush" />
    <StaticResource x:Key="VfSidebarSelectedItemBackgroundBrush" ResourceKey="VfShellSelectionBrush" />
    <StaticResource x:Key="VfSidebarHoverItemBackgroundBrush" ResourceKey="VfShellHoverBrush" />
    <StaticResource x:Key="VfSidebarFocusBrush" ResourceKey="VfShellFocusBrush" />
    <StaticResource x:Key="VfSidebarDisabledOpacity" ResourceKey="VfShellDisabledOpacity" />
    <StaticResource x:Key="VfSidebarItemHeight" ResourceKey="VfSizeBreadcrumbHeight" />
    <StaticResource x:Key="VfSidebarItemRadius" ResourceKey="VfRadiusBase" />
    <StaticResource x:Key="VfSidebarGroupSpacing" ResourceKey="VfSpace2" />
    <StaticResource x:Key="VfSidebarSectionSpacing" ResourceKey="VfSpace3" />
    <StaticResource x:Key="VfSidebarFocusThickness" ResourceKey="VfShellFocusThickness" />
    <x:Double x:Key="VfSidebarStatusOpacity">0.7</x:Double>
    <Thickness x:Key="VfSidebarPanePadding">12,8</Thickness>
    <Thickness x:Key="VfSidebarPaneBorderThickness">0,0,1,0</Thickness>
    <Thickness x:Key="VfSidebarNoBorderThickness">0</Thickness>
    <Thickness x:Key="VfSidebarNavigationListMargin">0,0,0,12</Thickness>
    <Thickness x:Key="VfSidebarItemPadding">10,6</Thickness>
    <Thickness x:Key="VfSidebarSecondarySectionPadding">0,12,0,0</Thickness>

    <Style x:Key="VfSidebarSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeSm}" />
        <Setter Property="Foreground" Value="{StaticResource VfSidebarTextMutedBrush}" />
    </Style>

    <Style x:Key="VfSidebarNavigationListStyle" TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource VfSidebarSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource VfSidebarNoBorderThickness}" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="Margin" Value="{StaticResource VfSidebarNavigationListMargin}" />
    </Style>

    <Style x:Key="VfSidebarItemContainerStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="{StaticResource VfSidebarItemHeight}" />
        <Setter Property="Padding" Value="{StaticResource VfSidebarItemPadding}" />
        <Setter Property="Background" Value="{StaticResource VfSidebarSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VfSidebarTextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource VfSidebarFocusBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource VfSidebarFocusThickness}" />
    </Style>

    <Style x:Key="VfSidebarItemTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource VfSidebarTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="VfSidebarItemKindTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeSm}" />
        <Setter Property="Foreground" Value="{StaticResource VfSidebarTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="VfSidebarSecondarySectionStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="{StaticResource VfSidebarGroupSpacing}" />
        <Setter Property="Padding" Value="{StaticResource VfSidebarSecondarySectionPadding}" />
    </Style>

    <Style x:Key="VfSidebarSecondaryControlRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="{StaticResource VfSidebarSectionSpacing}" />
    </Style>

    <Style x:Key="VfSidebarToggleStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource VfShellToggleSwitchStyle}" />

    <Style x:Key="VfSidebarTerminalPickerStyle" TargetType="ComboBox" BasedOn="{StaticResource VfShellComboBoxStyle}" />
</ResourceDictionary>
