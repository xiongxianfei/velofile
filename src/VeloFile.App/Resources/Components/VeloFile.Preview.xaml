<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="VfPreviewPaneBackgroundBrush" ResourceKey="VfShellSidebarBackgroundBrush" />
    <StaticResource x:Key="VfPreviewPaneBorderBrush" ResourceKey="VfShellSeparatorBrush" />
    <StaticResource x:Key="VfPreviewHeaderTextBrush" ResourceKey="VfShellTextPrimaryBrush" />
    <StaticResource x:Key="VfPreviewStatusTextBrush" ResourceKey="VfShellTextSecondaryBrush" />
    <StaticResource x:Key="VfPreviewContentTextBrush" ResourceKey="VfShellTextPrimaryBrush" />
    <StaticResource x:Key="VfPreviewMetadataLabelBrush" ResourceKey="VfShellTextMutedBrush" />
    <StaticResource x:Key="VfPreviewMetadataValueBrush" ResourceKey="VfShellTextSecondaryBrush" />
    <StaticResource x:Key="VfPreviewLoadingBrush" ResourceKey="VfShellAccentBrush" />
    <StaticResource x:Key="VfPreviewReadyBrush" ResourceKey="VfShellSuccessBrush" />
    <StaticResource x:Key="VfPreviewUnsupportedBrush" ResourceKey="VfShellWarningBrush" />
    <StaticResource x:Key="VfPreviewFailedBrush" ResourceKey="VfShellDangerBrush" />
    <StaticResource x:Key="VfPreviewButtonStyle" ResourceKey="VfShellButtonStyle" />
    <Thickness x:Key="VfPreviewPanePadding">12,10</Thickness>
    <Thickness x:Key="VfPreviewPaneBorderThickness">1,0,0,0</Thickness>
    <Thickness x:Key="VfPreviewNoBorderThickness">0</Thickness>
    <Thickness x:Key="VfPreviewMetadataRowPadding">0,3</Thickness>
    <Thickness x:Key="VfPreviewMetadataListMargin">0,2,0,0</Thickness>
    <x:Double x:Key="VfPreviewLayoutSpacing">8</x:Double>
    <x:Double x:Key="VfPreviewContentSpacing">6</x:Double>
    <x:Double x:Key="VfPreviewPdfNavigationSpacing">8</x:Double>
    <x:Double x:Key="VfPreviewImageMaxHeight">240</x:Double>

    <Style x:Key="VfPreviewPaneStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VfPreviewPaneBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VfPreviewPaneBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource VfPreviewPaneBorderThickness}" />
        <Setter Property="Padding" Value="{StaticResource VfPreviewPanePadding}" />
    </Style>

    <Style x:Key="VfPreviewLayoutStyle" TargetType="Grid">
        <Setter Property="RowSpacing" Value="{StaticResource VfPreviewLayoutSpacing}" />
    </Style>

    <Style x:Key="VfPreviewContentStackStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="{StaticResource VfPreviewContentSpacing}" />
    </Style>

    <Style x:Key="VfPreviewHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeMd}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource VfPreviewHeaderTextBrush}" />
    </Style>

    <Style x:Key="VfPreviewStatusStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeSm}" />
        <Setter Property="Foreground" Value="{StaticResource VfPreviewStatusTextBrush}" />
    </Style>

    <Style x:Key="VfPreviewLoadingStyle" TargetType="TextBlock" BasedOn="{StaticResource VfPreviewStatusStyle}">
        <Setter Property="Foreground" Value="{StaticResource VfPreviewLoadingBrush}" />
    </Style>

    <Style x:Key="VfPreviewReadyStyle" TargetType="TextBlock" BasedOn="{StaticResource VfPreviewStatusStyle}">
        <Setter Property="Foreground" Value="{StaticResource VfPreviewReadyBrush}" />
    </Style>

    <Style x:Key="VfPreviewUnsupportedStyle" TargetType="TextBlock" BasedOn="{StaticResource VfPreviewStatusStyle}">
        <Setter Property="Foreground" Value="{StaticResource VfPreviewUnsupportedBrush}" />
    </Style>

    <Style x:Key="VfPreviewFailedStyle" TargetType="TextBlock" BasedOn="{StaticResource VfPreviewStatusStyle}">
        <Setter Property="Foreground" Value="{StaticResource VfPreviewFailedBrush}" />
    </Style>

    <Style x:Key="VfPreviewContentTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource VfPreviewContentTextBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="VfPreviewPdfNavigationStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="{StaticResource VfPreviewPdfNavigationSpacing}" />
    </Style>

    <Style x:Key="VfPreviewPdfButtonStyle" TargetType="Button" BasedOn="{StaticResource VfPreviewButtonStyle}" />

    <Style x:Key="VfPreviewPdfPageIndicatorStyle" TargetType="TextBlock" BasedOn="{StaticResource VfPreviewStatusStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="VfPreviewImageStyle" TargetType="Image">
        <Setter Property="MaxHeight" Value="{StaticResource VfPreviewImageMaxHeight}" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <Style x:Key="VfPreviewMetadataStyle" TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource VfPreviewPaneBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VfPreviewPaneBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource VfPreviewNoBorderThickness}" />
        <Setter Property="Margin" Value="{StaticResource VfPreviewMetadataListMargin}" />
        <Setter Property="SelectionMode" Value="None" />
    </Style>

    <Style x:Key="VfPreviewMetadataRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="{StaticResource VfPreviewContentSpacing}" />
        <Setter Property="Padding" Value="{StaticResource VfPreviewMetadataRowPadding}" />
    </Style>

    <Style x:Key="VfPreviewMetadataLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeSm}" />
        <Setter Property="Foreground" Value="{StaticResource VfPreviewMetadataLabelBrush}" />
    </Style>

    <Style x:Key="VfPreviewMetadataValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VfFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource VfTextSizeSm}" />
        <Setter Property="Foreground" Value="{StaticResource VfPreviewMetadataValueBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</ResourceDictionary>
