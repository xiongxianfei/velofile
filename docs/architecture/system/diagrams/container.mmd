C4Container
  title VeloFile V1 - Container View

  Person(user, "Windows user", "Browses, previews, searches, and operates on files.")
  Person(contributor, "Maintainer or contributor", "Authors UI contracts, reviews visual evidence, and runs validation.")

  System_Boundary(velofile, "VeloFile V1") {
    Container(app, "VeloFile desktop app", "WinUI 3 / Windows App SDK / C#", "Interactive desktop application. Hosts UI, commands, search/filter orchestration, preview orchestration, Shell interop adapters, and file-operation orchestration.")
    ContainerDb(localData, "Local app data", "Versioned JSON + local diagnostic log files", "Stores settings, favorites, recent locations, session state, local crash markers, and redacted diagnostics. Written with same-directory temp files, Windows-safe atomic replacement, last-known-good backups, and diagnostics retention limits.")
    Container(uiContractTooling, "UI contract tooling", ".NET console + PowerShell", "Validates repo-owned UI token, scope, icon, screenshot metadata, and visual evidence contracts against WinUI resources; static checks do not require the running app.")
    Container(corpusValidation, "Corpus validation tooling", ".NET tests + corpus tool + PowerShell", "Runs validation tiers, corpus contract checks, public script smoke tests, hermetic wrapper isolation, prepared-tool test execution, and runtime reporting.")
    Container(hostedCi, "Hosted CI validation workflows", "GitHub Actions YAML + PowerShell", "Runs ci-fast-required, ci-release-evidence, and ci-full-closeout on Windows runners with pwsh, explicit SDK setup, lane-specific commands, TRX output, and job summaries.")
    ContainerDb(visualEvidence, "Visual baseline evidence", "PNG screenshots + JSON sidecars", "Stores reviewed first-slice and shell-wide soft-review baselines; generated current captures and diffs are transient and not committed.")
    Container(benchmarkHarness, "Benchmark harness", "Test executable", "Runs generated-corpus app benchmarks outside normal user runtime and emits benchmark reports for release gating.")
    Container(releaseChannel, "MSIX package and stable release channel", "Signed MSIX + release metadata", "Distributes V1 side by side with Explorer, records signing identity, versioning policy, update cadence expectation, and rollback/uninstall instructions.")
  }

  System_Ext(windowsPlatform, "Windows platform", "File system, Shell APIs, Recycle Bin, thumbnails/icons, file associations, terminal processes, WSL, drag/drop, DPI, and accessibility services.")
  System_Ext(otherApps, "Other desktop apps", "Explorer, browsers, IDEs, Office, and other drag/drop or file-association participants.")
  System_Ext(userFileLocations, "User file locations", "Local disks, removable media, mapped/network drives, cloud-placeholder folders, and protected locations.")
  System_Ext(githubActions, "GitHub Actions hosted Windows runners", "Runs Windows-hosted validation with pwsh and the repository-approved .NET SDK.")

  Rel(user, app, "Uses")
  Rel(contributor, uiContractTooling, "Runs validation and baseline approval")
  Rel(contributor, corpusValidation, "Runs fast, contract, smoke, release-evidence, and full validation tiers")
  Rel(contributor, hostedCi, "Opens PRs and triggers manual/release validation")
  Rel(contributor, visualEvidence, "Reviews committed baselines")
  Rel(app, localData, "Reads/writes versioned local state and local-only diagnostics")
  Rel(app, windowsPlatform, "Uses Shell, Win32, Windows App SDK, terminal, accessibility, and packaging APIs")
  Rel(app, userFileLocations, "Enumerates, previews, searches, and operates on files")
  Rel(app, otherApps, "Exchanges drag/drop data and opens files through associations")
  Rel(uiContractTooling, app, "Validates XAML resources and test fixture launch contracts")
  Rel(uiContractTooling, visualEvidence, "Copies reviewed baselines and checks metadata")
  Rel(hostedCi, githubActions, "Executes on")
  Rel(hostedCi, uiContractTooling, "Runs production UI contract validation")
  Rel(hostedCi, corpusValidation, "Runs fast, script-smoke, release-evidence, and closeout validation commands")
  Rel(hostedCi, app, "Builds solution and runs App test project")
  Rel(corpusValidation, userFileLocations, "Creates scratch corpus data and validates generated reports")
  Rel(corpusValidation, benchmarkHarness, "Supplies corpus and release-evidence checks")
  Rel(benchmarkHarness, app, "Starts and drives measured workflows")
  Rel(benchmarkHarness, userFileLocations, "Creates and uses deterministic generated corpus")
  Rel(releaseChannel, app, "Installs, updates, and uninstalls")
